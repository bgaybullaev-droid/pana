# =============================================================================
# PANA Backend Configuration
# Copy this to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# Application
APP_NAME=ucharmarket
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_min_32_chars_random_string_here
API_V1_PREFIX=/api/v1

# Moderation
AUTO_APPROVE_LISTINGS=false
AUTO_APPROVE_USERS=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=real_estate

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_min_32_chars_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Block D D1 — Mini App URL opened by the bot's Menu Button.
# Leave empty in dev to skip menu-button setup. Example:
#   TELEGRAM_WEBAPP_URL=https://pana.uz
TELEGRAM_WEBAPP_URL=

# Admin Panel
ADMIN_USERNAME=CHANGE_ME_admin_user
ADMIN_PASSWORD=CHANGE_ME_min_8_chars

# External APIs (optional)
OPENAI_API_KEY=
GEMINI_API_KEY=

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=realestate-images
CLOUDFRONT_DOMAIN=

# Sentry (optional)
SENTRY_DSN=

# CORS Origins (JSON array or comma-separated)
CORS_ORIGINS=["https://t.me","https://web.telegram.org"]

# Rate Limiting
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_SEARCH=30
