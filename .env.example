# Real Estate Frontend Environment Variables

# API URL (defaults to /api/v1 when not set - uses Vite proxy)
VITE_API_URL=

# App name
VITE_APP_NAME=Real Estate

# Environment
VITE_ENV=development

# Telegram Bots
VITE_SELLER_BOT_USERNAME=your_seller_bot_username
VITE_BUYER_BOT_USERNAME=ucharTestMarket_bot
VITE_MINI_APP_SHORT_NAME=app
