# Real Estate Frontend Environment Variables

# API URL — remote backend
VITE_API_URL=/api/v1

# App name
VITE_APP_NAME=Real Estate

# Environment
VITE_ENV=production

# Image base URL (VPS)
VITE_IMAGE_BASE_URL=https://ucharmarket.uz

# Telegram Bots
VITE_SELLER_BOT_USERNAME=your_seller_bot_username
VITE_BUYER_BOT_USERNAME=ucharTestMarket_bot
VITE_MINI_APP_SHORT_NAME=app

  ➜  Local:   http://localhost:7878/
  ➜  Network: http://192.168.0.106:7878/
  ucharmarket-frontend.netlify.app

  npm run build && netlify deploy --prod --dir=dist
  npm run dev