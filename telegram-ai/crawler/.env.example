# Telegram AI Crawler - Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================
# LLM Configuration
# ===========================

# Anthropic (Claude) API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-actual-key-here

# Anthropic Model Selection (only one model used)
# Options:
#   claude-3-5-sonnet-20241022 (best quality, ~$3 per 1000 messages)
#   claude-3-5-haiku-20241022 (cheaper, ~$0.25 per 1000 messages)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API Key (if using OpenAI instead)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-actual-key-here

# OpenAI Model Selection
OPENAI_MODEL=gpt-4o-2024-08-06

# LLM Provider Selection
# Options: 'anthropic', 'openai', 'ollama'
LLM_PROVIDER=anthropic

# ===========================
# Telegram Configuration
# ===========================

# Get from: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE_NUMBER=+998901234567
TELEGRAM_SESSION_NAME=main_session

# Historical Messages Processing
# How many past messages to process on startup (per channel)
# Set to 0 to only monitor new messages
# Recommended: 10-50 for initial testing, then set to 0 for production
PROCESS_HISTORICAL_MESSAGES=10

# ===========================
# Image Embedding Configuration
# ===========================

# CLIP Model Selection
# Options: 'ViT-B/32' (fast), 'ViT-B/16' (better), 'ViT-L/14' (best)
CLIP_MODEL_NAME=ViT-B/32

# Device for CLIP
# Options: 'cuda' (if you have NVIDIA GPU), 'cpu'
CLIP_DEVICE=cuda

# ===========================
# Vector Database Configuration
# ===========================

# Vector database type
# Options: 'chromadb', 'faiss'
VECTOR_DB_TYPE=chromadb

# ChromaDB directory
CHROMA_PERSIST_DIR=./crawler/vector_db

# ===========================
# Similarity Thresholds
# ===========================

# Image similarity threshold (0.0 to 1.0)
# Instagram uses ~0.85-0.90 for duplicate detection
IMAGE_SIMILARITY_THRESHOLD=0.88

# Text similarity threshold (0.0 to 1.0)
TEXT_SIMILARITY_THRESHOLD=0.92

# ===========================
# Cost Optimization
# ===========================

# Enable response caching (saves money on identical messages)
ENABLE_RESPONSE_CACHE=true

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Maximum tokens for extraction
MAX_TOKENS=2000

# ===========================
# Duplicate Detection
# ===========================

# Action when duplicate found
# Options: 'skip', 'flag', 'merge', 'store_both'
DUPLICATE_ACTION=skip

# ===========================
# Logging
# ===========================

# Enable verbose logging
VERBOSE=true

# Log LLM calls
LOG_LLM_CALLS=true

# Log similarity searches
LOG_SIMILARITY_SEARCHES=true

# Save failed extractions
SAVE_FAILED_EXTRACTIONS=true

# ===========================
# API Server Configuration
# ===========================

# API server host and port
API_HOST=0.0.0.0
API_PORT=5000

# Database file
DATABASE_FILE=telegram_listings_llm.db

# Upload directory
UPLOAD_FOLDER=uploads

# Telegram API Credentials
# Get these from https://my.telegram.org -> API Development Tools

TELEGRAM_API_ID=37240224
TELEGRAM_API_HASH=8d39c582371dfc11018ca3dfb33fc10c
TELEGRAM_PHONE_NUMBER=+998903172052
TELEGRAM_SESSION_NAME=main_session

# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-embedding-2-preview

# Ollama (local LLM via Docker - free, no rate limits)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# UcharMarket Backend (auto-push crawled data)
BACKEND_URL=http://localhost:7879
